<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="aurora.SubMenu">
  <ul class="aurora_sub">
    <li t-foreach="items" t-as="m" t-key="m.id">
      <a href="#" class="aurora_sub_item" t-att-class="{'is-section': !m.actionID}"
         t-on-click.prevent="() => ctx.clickMenu(m)" t-att-title="m.name">
        <span t-esc="m.name"/>
        <i t-if="m.childrenTree and m.childrenTree.length" t-att-class="'fa ' + (ctx.state.open[m.id] ? 'fa-angle-down' : 'fa-angle-right')"/>
      </a>
      <t t-if="m.childrenTree and m.childrenTree.length and ctx.state.open[m.id]">
        <t t-call="aurora.SubMenu"><t t-set="items" t-value="m.childrenTree"/></t>
      </t>
    </li>
  </ul>
</t>

<t t-name="aurora.Sidebar">
  <aside class="aurora_sidebar" t-att-class="{'is-mini': state.collapsed}">
    <a class="aurora_brand" href="/odoo" t-att-title="state.brand ? state.brand.name : 'Home'">
      <span class="aurora_brand_logo" t-if="state.brand and state.brand.has_logo and state.logoOk">
        <img t-att-src="logoUrl" t-att-alt="state.brand.name" t-on-error="() => this.state.logoOk = false"/>
      </span>
      <span class="aurora_brand_initial" t-else="" t-esc="(state.brand and state.brand.name or 'O')[0]"/>
      <span class="aurora_brand_name" t-if="state.brand" t-esc="state.brand.name"/>
    </a>
    <nav class="aurora_apps">
      <t t-foreach="apps" t-as="app" t-key="app.id">
        <div class="aurora_app_wrap" t-att-class="{'active': app.id === currentId, 'open': state.open[app.id]}">
          <a href="#" class="aurora_app" t-att-title="app.name"
             t-on-click.prevent="() => this.openApp(app)"
             t-on-mouseenter="(ev) => this.showFly(ev, app)" t-on-mouseleave="hideFly">
            <img t-if="app.webIconData" t-att-src="app.webIconData" alt=""/>
            <span t-else="" class="aurora_app_fallback" t-esc="app.name[0]"/>
            <span class="aurora_app_name" t-esc="app.name"/>
            <i t-if="hasKids(app)" class="aurora_caret fa" t-att-class="state.open[app.id] ? 'fa-angle-down' : 'fa-angle-right'"
               t-on-click="(ev) => this.toggleOpen(ev, app.id)" title="Expand / collapse"/>
          </a>
          <div class="aurora_app_menus" t-if="state.open[app.id] and hasKids(app)">
            <t t-call="aurora.SubMenu"><t t-set="items" t-value="tree(app)"/><t t-set="ctx" t-value="this"/></t>
          </div>
        </div>
      </t>
    </nav>
    <button class="aurora_collapse" t-on-click="toggle" t-att-title="state.collapsed ? 'Expand menu' : 'Collapse menu'">
      <i t-att-class="'fa ' + (state.collapsed ? 'fa-angle-double-right' : 'fa-angle-double-left')"/>
      <span class="aurora_app_name">Collapse</span>
    </button>
  </aside>
  <div class="aurora_fly" t-if="state.fly" t-att-style="'top:' + state.fly.top + 'px'"
       t-on-mouseenter="keepFly" t-on-mouseleave="hideFly">
    <a href="#" class="aurora_fly_head" t-on-click.prevent="() => this.openApp(state.fly.app)" t-esc="state.fly.app.name"/>
    <t t-call="aurora.SubMenu"><t t-set="items" t-value="tree(state.fly.app)"/><t t-set="ctx" t-value="this"/></t>
  </div>
</t>
</templates>
