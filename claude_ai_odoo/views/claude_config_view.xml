<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════════════
         FORM VIEW
    ════════════════════════════════════════════════ -->
    <record id="view_claude_config_form" model="ir.ui.view">
        <field name="name">claude.config.form</field>
        <field name="model">claude.config</field>
        <field name="arch" type="xml">
            <form string="Claude AI Configuration">
                <header>
                    <button name="action_set_active"
                            string="Set as Active"
                            type="object"
                            class="btn-primary"
                            invisible="active"/>
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="btn-secondary"/>
                    <field name="connection_status" widget="statusbar"
                           statusbar_visible="untested,ok,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_set_active"
                                icon="fa-power-off"
                                invisible="active">
                            <span class="o_stat_text">Set Active</span>
                        </button>
                        <div class="oe_stat_button" style="cursor:default;" invisible="not active">
                            <i class="fa fa-check-circle" style="color:#28a745;font-size:20px;margin:8px;"/>
                            <span class="o_stat_text" style="color:#28a745;">Active</span>
                        </div>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>

                    <div class="alert alert-success mb-3" role="alert"
                         invisible="connection_status != 'ok'">
                        ✅ <field name="connection_message" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-danger mb-3" role="alert"
                         invisible="connection_status != 'error'">
                        ❌ <field name="connection_message" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="connection_status != 'untested'">
                        Enter your API key below, click <strong>Save</strong>, then <strong>Test Connection</strong>.
                        Get a key at <a href="https://console.anthropic.com" target="_blank">console.anthropic.com</a>
                    </div>

                    <group string="Anthropic API">
                        <group>
                            <field name="api_key" placeholder="sk-ant-api03-..."
                                   help="Type your key and click Save." password="True"/>
                            <field name="model_name"/>
                        </group>
                        <group>
                            <field name="max_tokens"/>
                            <field name="temperature"/>
                            <field name="request_timeout"/>
                        </group>
                    </group>

                    <group string="Behaviour">
                        <group>
                            <field name="require_confirmation"/>
                            <field name="log_all_actions"/>
                        </group>
                        <group>
                            <field name="last_tested" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="System Prompt">
                        <field name="system_prompt" nolabel="1" widget="text"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════
         LIST VIEW
    ════════════════════════════════════════════════ -->
    <record id="view_claude_config_list" model="ir.ui.view">
        <field name="name">claude.config.list</field>
        <field name="model">claude.config</field>
        <field name="arch" type="xml">
            <list string="Claude AI Configurations"
                  decoration-success="active == True"
                  decoration-muted="active == False">
                <field name="name"/>
                <field name="model_name"/>
                <field name="connection_status"
                       decoration-success="connection_status == 'ok'"
                       decoration-danger="connection_status == 'error'"
                       decoration-warning="connection_status == 'untested'"/>
                <field name="last_tested"/>
                <field name="active" widget="boolean_toggle" string="Active"/>
                <button name="action_set_active"
                        string="Set Active"
                        type="object"
                        icon="fa-toggle-off"
                        invisible="active"
                        title="Make this the active configuration"/>
                <button name="action_test_connection"
                        string="Test"
                        type="object"
                        icon="fa-plug"
                        title="Test API connection"/>
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════
         WINDOW ACTION — list + form
    ════════════════════════════════════════════════ -->
    <record id="action_claude_config" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">claude.config</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>

</odoo>
