<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_claude_user" model="res.groups">
            <field name="name">Claude AI / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_claude_admin" model="res.groups">
            <field name="name">Claude AI / Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_claude_user'))]"/>
        </record>
        <!-- Settings administrators are Claude AI administrators (menus visible after install) -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_claude_admin'))]"/>
        </record>
    </data>
</odoo>
