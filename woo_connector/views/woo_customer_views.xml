<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_woo_customer_list" model="ir.ui.view">
        <field name="name">woo.customer.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="WooCommerce Customers">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="woo_instance_id"/>
                <field name="woo_customer_id"/>
            </list>
        </field>
    </record>

    <record id="view_woo_customer_search" model="ir.ui.view">
        <field name="name">woo.customer.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="email"/>
                <field name="woo_instance_id"/>
                <filter name="woo_only" string="WooCommerce Customers"
                        domain="[('is_woo_customer','=',True)]"/>
                <filter name="group_instance" string="Instance"
                        context="{'group_by': 'woo_instance_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_woo_customers" model="ir.actions.act_window">
        <field name="name">WooCommerce Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_woo_customer', '=', True)]</field>
        <field name="search_view_id" ref="view_woo_customer_search"/>
        <field name="context">{'default_is_woo_customer': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customers imported yet!
            </p>
            <p>Use Manual Sync → Customers to import customers from WooCommerce.</p>
        </field>
    </record>

</odoo>
