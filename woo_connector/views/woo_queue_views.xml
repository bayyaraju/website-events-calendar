<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_woo_queue_list" model="ir.ui.view">
        <field name="name">woo.queue.line.list</field>
        <field name="model">woo.queue.line</field>
        <field name="arch" type="xml">
            <list string="WooCommerce Queue"
                  decoration-danger="state == 'failed'"
                  decoration-success="state == 'done'"
                  decoration-info="state == 'processing'">
                <field name="name"/>
                <field name="instance_id"/>
                <field name="queue_type"/>
                <field name="woo_id"/>
                <field name="state"/>
                <field name="retry_count"/>
                <field name="processed_date"/>
                <field name="error_message"/>
                <button name="action_process" string="Retry" type="object"
                        invisible="state not in ('draft', 'failed')"/>
                <button name="action_reset" string="Reset" type="object"
                        invisible="state != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_woo_queue_search" model="ir.ui.view">
        <field name="name">woo.queue.line.search</field>
        <field name="model">woo.queue.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="instance_id"/>
                <filter name="pending" string="Pending" domain="[('state','=','draft')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
            </search>
        </field>
    </record>

    <record id="action_woo_queue" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">woo.queue.line</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_woo_queue_search"/>
    </record>

</odoo>