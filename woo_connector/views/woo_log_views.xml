<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_woo_log_list" model="ir.ui.view">
        <field name="name">woo.log.list</field>
        <field name="model">woo.log</field>
        <field name="arch" type="xml">
            <list string="WooCommerce Logs"
                  default_order="create_date desc"
                  decoration-danger="level == 'error'"
                  decoration-warning="level == 'warning'"
                  decoration-success="level == 'success'">
                <field name="create_date"/>
                <field name="instance_id"/>
                <field name="level"/>
                <field name="message"/>
                <field name="model"/>
                <field name="res_id"/>
            </list>
        </field>
    </record>

    <record id="view_woo_log_search" model="ir.ui.view">
        <field name="name">woo.log.search</field>
        <field name="model">woo.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="instance_id"/>
                <filter name="errors" string="Errors"
                        domain="[('level','=','error')]"/>
                <filter name="warnings" string="Warnings"
                        domain="[('level','=','warning')]"/>
                <filter name="today" string="Today"
                        domain="[('create_date','>=', (context_today()).strftime('%Y-%m-%d'))]"/>
            </search>
        </field>
    </record>

    <record id="action_woo_logs" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">woo.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_woo_log_search"/>
    </record>

</odoo>