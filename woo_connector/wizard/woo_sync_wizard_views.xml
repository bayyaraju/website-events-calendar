<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_woo_sync_wizard_form" model="ir.ui.view">
        <field name="name">woo.sync.wizard.form</field>
        <field name="model">woo.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Sync">
                <group>
                    <field name="instance_id"/>
                    <field name="sync_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_sync" string="Sync Now"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_woo_sync_wizard" model="ir.actions.act_window">
        <field name="name">Manual Sync</field>
        <field name="res_model">woo.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

