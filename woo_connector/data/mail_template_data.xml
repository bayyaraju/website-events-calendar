<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_woo_sync_error" model="mail.template">
            <field name="name">WooCommerce: Sync Error Notification</field>
            <field name="model_id" ref="model_woo_instance"/>
            <field name="subject">WooCommerce Sync Error - {{ object.name }}</field>
            <field name="body_html"><![CDATA[
<p>Hello,</p>
<p>A WooCommerce sync error occurred for instance <strong>{{ object.name }}</strong>.</p>
<p>Please check the sync logs in Odoo for details.</p>
]]></field>
        </record>
    </data>
</odoo>
