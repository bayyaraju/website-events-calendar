<!--        <filter string="SLA Breached"     domain="[('state','=','sla_breached')]"/>-->
<!--        <filter string="Error"            domain="[('state','=','error')]"/>-->
<!--        <filter string="Completed"        domain="[('state','=','completed')]"/>-->
<!--        <separator/>-->
<!--        <filter string="Assigned to Me"   domain="[('assigned_user_id','=',user.id)]"/>-->
<!--        <filter string="My Instances"     domain="[('owner_id','=',uid)]"/>-->
<!--        <group expand="0" string="Group By">-->
<!--          <filter string="Workflow" context="{'group_by':'definition_id'}"/>-->
<!--          <filter string="Status"   context="{'group_by':'state'}"/>-->
<!--          <filter string="Stage"    context="{'group_by':'current_stage_id'}"/>-->
<!--        </group>-->
      </search>
    </field>
  </record>

  <!-- ── Actions ───────────────────────────────────────────────────────────── -->
  <record id="action_wf_instance" model="ir.actions.act_window">
    <field name="name">Workflow Instances</field>
    <field name="res_model">wf.instance</field>
    <field name="view_mode">list,form,graph,pivot</field>
    <field name="search_view_id" ref="view_wf_instance_search"/>
<!--    <field name="context">{'search_default_Running': 1}</field>-->
  </record>

  <record id="action_wf_instance_analytics" model="ir.actions.act_window">
    <field name="name">Workflow Analytics</field>
    <field name="res_model">wf.instance</field>
    <field name="view_mode">graph,pivot,list</field>
    <field name="search_view_id" ref="view_wf_instance_search"/>
  </record>

</odoo>
