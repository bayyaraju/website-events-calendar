  <!-- ── Search ────────────────────────────────────────────────────────────── -->
  <record id="view_wf_def_search" model="ir.ui.view">
    <field name="name">wf.definition.search</field>
    <field name="model">wf.definition</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/><field name="code"/><field name="model_id"/>
        <filter string="Active"     name="f_active"     domain="[('state','=','active')]"/>
        <filter string="Draft"      name="f_draft"      domain="[('state','=','draft')]"/>
        <filter string="Deprecated" name="f_deprecated" domain="[('state','=','deprecated')]"/>
<!--        <group expand="0" string="Group By">-->
<!--          <filter string="Model"   context="{'group_by':'model_id'}"/>-->
<!--          <filter string="Status"  context="{'group_by':'state'}"/>-->
<!--          <filter string="Trigger" context="{'group_by':'trigger_type'}"/>-->
<!--        </group>-->
      </search>
    </field>
  </record>

  <!-- ── Action ────────────────────────────────────────────────────────────── -->
  <record id="action_wf_definition" model="ir.actions.act_window">
    <field name="name">Workflow Definitions</field>
    <field name="res_model">wf.definition</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_wf_def_search"/>
<!--    <field name="context">{'search_default_f_active': 1}</field>-->
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Create your first workflow</p>
      <p>Design visual processes with stages, approvals, SLAs and automated actions.</p>
    </field>
  </record>

</odoo>
