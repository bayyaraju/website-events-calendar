<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_wf_trigger_wizard" model="ir.ui.view">
    <field name="name">wf.trigger.wizard.form</field>
    <field name="model">wf.trigger.wizard</field>
    <field name="arch" type="xml">
      <form string="Start Workflow">
        <group>
          <field name="res_name"      readonly="1" string="Record"/>
          <field name="res_model"     invisible="1"/>
          <field name="res_id"        invisible="1"/>
          <field name="definition_id"/>
          <field name="note" placeholder="Optional note…"/>
        </group>
        <footer>
          <button name="action_start" type="object"
                  string="Start Workflow" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_wf_delegate_wizard" model="ir.ui.view">
    <field name="name">wf.delegate.wizard.form</field>
    <field name="model">wf.delegate.wizard</field>
    <field name="arch" type="xml">
      <form string="Delegate Approval">
        <group>
          <field name="approval_id" readonly="1"/>
          <field name="delegate_to"/>
          <field name="reason"/>
        </group>
        <footer>
          <button name="action_delegate" type="object"
                  string="Delegate" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

</odoo>
